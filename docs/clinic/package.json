{
  "name": "rulekit-clinic",
  "version": "0.1.0",
  "description": "The rulekit research clinic: a scroll-driven three.js staging of the plain-language thesis page, with the 2D reading version served at /plain.",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run && npm run parity",
    "dev": "vite",
    "build": "node scripts/sync-plain.mjs && vite build",
    "preview": "vite preview",
    "start": "serve dist -l ${PORT:-3000}",
    "parity": "node scripts/copy-parity.mjs",
    "smoke": "node scripts/smoke.mjs",
    "verify": "npm run build && npm test && npm run smoke"
  },
  "author": "Emmanuel Cuyugan",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "gsap": "^3.15.0",
    "serve": "^14.2.6",
    "three": "^0.185.1"
  },
  "devDependencies": {
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
