{
  "name": "rulekit",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "facts": "tsx src/cli-facts/index.ts",
    "facts:check": "tsx src/cli-facts/index.ts check corpus/facts",
    "facts:eval": "tsx src/cli-facts/index.ts eval --min-precision 0.95 --min-recall 0.95",
    "extract:corpus": "tsx scripts/extract-corpus.ts",
    "eval": "npm run build && promptfoo eval -c evals/promptfooconfig.yaml"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "promptfoo": "^0.122.0",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.120.0",
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  }
}
