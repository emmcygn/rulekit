{
  "name": "rulekit",
  "version": "0.1.0",
  "description": "",
  "main": "index.js",
  "directories": {
    "test": "tests"
  },
  "scripts": {
    "test": "vitest run",
    "lint": "eslint .",
    "build": "tsc -p tsconfig.json",
    "rules": "tsx src/cli/index.ts",
    "dogfood": "tsx src/cli/index.ts check rules/trials/demo-hf-001/ruleset@1.0.0.yaml --fact-model packs/trials/fact-model.yaml && tsx src/cli/index.ts test rules/trials/demo-hf-001 --fact-model packs/trials/fact-model.yaml --corpus fixtures/patients",
    "corpus:fetch": "tsx scripts/fetch-synthea.ts",
    "corpus:flatten": "tsx scripts/flatten-synthea.ts",
    "corpus:mess": "tsx scripts/mess-injector.ts",
    "corpus:normalize": "tsx scripts/normalize.ts",
    "corpus:build": "npm run corpus:fetch && npm run corpus:flatten && npm run corpus:mess && npm run corpus:normalize",
    "chia:coverage": "tsx scripts/chia-coverage.ts",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.scripts.json"
  },
  "keywords": [],
  "author": "",
  "license": "Apache-2.0",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^26.2.0",
    "eslint": "^10.8.1",
    "tsx": "^4.23.12",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.67.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "yaml": "^2.9.0",
    "zod": "^4.4.3"
  },
  "bin": {
    "rules": "dist/cli/index.js"
  }
}
